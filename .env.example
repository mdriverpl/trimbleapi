PORT=3000
ADMIN_TOKEN=replace-with-a-long-random-token-at-least-24-characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-characters
# Only used by compose.local.yaml / start:local
POSTGRES_PASSWORD=replace-with-a-random-hex-password
POSTGRES_PORT=5432
# Docker Compose + Hostava: replace the password (URL-encode special characters).
DATABASE_URL=postgresql://hostava:replace-with-hostava-password@71a720c598f73f7a5d4c244bb2659732.db.hostava.pl:5432/defaultdb?sslmode=verify-full&sslrootcert=/app/certs/hostava-db-ca.pem
WORKER_COUNT=10

# GHCR tag: latest or sha-<full commit hash>
IMAGE_TAG=latest
